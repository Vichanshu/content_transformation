NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

POSTGRES_USER=transformation
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=transformation_db
DATABASE_URL=postgresql://transformation:change-me-for-local-development@postgres:5432/transformation_db?schema=public

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV_SERVER_URL=http://host.docker.internal:8288

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
LITELLM_PROXY_URL=http://host.docker.internal:4000
LITELLM_API_KEY=
LITELLM_ROUTER_MODEL=gpt-4o-mini
LITELLM_SINGLE_MODEL=claude-3-5-haiku-latest
LITELLM_SPECIALIST_MODEL=claude-3-5-haiku-latest
LITELLM_JUDGE_MODEL=gpt-4o

WORKER_INTERNAL_URL=http://worker:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_SOURCE_BYTES=104857600
SOURCE_TIMEOUT_SECONDS=60
DOCLING_TIMEOUT_SECONDS=300
FFMPEG_TIMEOUT_SECONDS=120
DEEPGRAM_TIMEOUT_SECONDS=120
