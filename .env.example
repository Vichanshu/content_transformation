NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon supplies these through `neon link`. The pooled URL is for the app;
# Prisma migrations use the direct URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV_SERVER_URL=http://host.docker.internal:8288

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MEDIA_MODEL=gemini-2.5-flash-lite

WORKER_INTERNAL_URL=http://worker:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_SOURCE_BYTES=104857600
SOURCE_TIMEOUT_SECONDS=60
DOCLING_TIMEOUT_SECONDS=300
FFMPEG_TIMEOUT_SECONDS=120
GEMINI_TIMEOUT_SECONDS=180
